# AgriShield AI — Environment Variables
# Copy this file to .env and fill in your values.
# The application runs fully offline (rule-based engine) without any of these.

# ── IBM Granite / watsonx (optional) ─────────────────────────────────────────
# GRANITE_API_KEY=your_ibm_watsonx_api_key_here
# GRANITE_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation
# GRANITE_MODEL=ibm/granite-3-8b-instruct

# ── OpenAI-compatible fallback (optional) ────────────────────────────────────
# OPENAI_API_KEY=sk-...
